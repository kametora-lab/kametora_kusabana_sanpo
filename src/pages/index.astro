---
import Layout from '../layouts/Layout.astro';
import TopSlideshow from '../components/TopSlideshow.astro';
import plants from '../data/plants.json';

const latestPlants = plants.slice(-6).reverse();

const getImageSrc = (images) => {
	if (!images || images.length === 0) return '';
	const first = images[0];
	return typeof first === 'string' ? first : first.src;
};
---

<Layout
	title="奄美の草花さんぽ帖"
	description="世界自然遺産の島・奄美大島で撮りためた草花たちをまとめた写真帖です。お散歩気分で、草花の世界をそっとのぞいてみませんか。"
	keywords="奄美の草花,草花図鑑,植物図鑑,奄美の花,奄美大島の自然,野の花アルバム,奄美大島,奄美さんぽ"
>
	<main class="mx-auto min-h-screen max-w-6xl px-6 pb-20 md:px-10 lg:px-16">
		<div class="pt-6 md:pt-10">
			<TopSlideshow>
				<section class="w-full space-y-5 px-6 py-12 md:px-10 md:py-20 lg:px-16 lg:py-24 text-center">
					<p class="text-xs tracking-[0.4em] text-neutral-300 md:text-sm drop-shadow-md">AMAMI FLORA ARCHIVE</p>
					<h1 class="font-serif text-4xl leading-tight tracking-tight text-white md:text-6xl drop-shadow-lg">
						奄美の草花さんぽ帖
					</h1>
					<div class="space-y-1 pt-4">
						<p class="text-base text-neutral-200 md:text-lg drop-shadow">
							奄美大島で出会った草花の記録。
						</p>
						<p class="text-base text-neutral-200 md:text-lg drop-shadow">
							世界自然遺産の島、奄美大島で草花を探して記録しています。
						</p>
					</div>
				</section>
			</TopSlideshow>
		</div>

			<div class="pt-12 pb-3 md:pt-16 md:pb-4">
				<div class="mb-4 flex flex-wrap items-center gap-x-6 gap-y-3">
					<h2 class="flex items-center gap-3 font-serif text-2xl text-neutral-100 md:text-3xl">
						<span class="rounded-full bg-red-500 px-2 py-1 text-[10px] font-sans font-bold uppercase tracking-[0.2em] text-white shadow-[0_0_12px_rgba(255,60,60,0.6)]">
							NEW
						</span>
						新着草花
					</h2>
					<form action="/kametora_kusabana_sanpo/plants" method="GET" class="relative flex items-center w-full sm:w-48">
						<input
							type="text"
							name="q"
							id="top-search"
							placeholder="カタカナで検索"
							lang="ja"
							inputmode="kana"
							autocomplete="off"
							class="w-full border border-white/10 bg-transparent pl-3 pr-8 py-1.5 text-xs text-neutral-200 focus:border-white/30 focus:outline-none placeholder-neutral-500"
						/>
						<button type="submit" class="absolute right-2.5 text-neutral-400 hover:text-neutral-200" aria-label="検索">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
								<path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.602 10.602Z" />
							</svg>
						</button>
					</form>
				</div>
				<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
				{/* Left Column: New Plants (2/3 width) */}
				<section class="lg:col-span-2">
					<div class="grid grid-cols-2 md:grid-cols-3 gap-4">
						{latestPlants.map((plant) => (
							<a
								href={`/kametora_kusabana_sanpo/plants/${plant.slug}`}
								class="group relative block overflow-hidden border border-white/10 bg-[#0f0f0f] aspect-[4/3]"
							>
								{getImageSrc(plant.images) ? (
									<img
										src={getImageSrc(plant.images)}
										alt={plant.title}
										class="h-full w-full object-cover transition-opacity duration-300 group-hover:opacity-85"
										loading="lazy"
										decoding="async"
									/>
								) : (
									<div class="flex h-full w-full items-center justify-center bg-[#111] text-xs text-neutral-600">
										NO IMAGE
									</div>
								)}
								<div class="absolute inset-x-0 bottom-0 border-t border-white/10 bg-black/60 px-3 py-2 backdrop-blur-sm">
									<div class="truncate text-sm text-neutral-200">{plant.title}</div>
									{plant.meta?.scientificName && (
										<div class="truncate text-[10px] text-neutral-500">{plant.meta.scientificName}</div>
									)}
								</div>
							</a>
						))}
					</div>
				</section>

				{/* Right Column: Video (1/3 width) */}
				<section class="lg:col-span-1 lg:relative">
					<div class="w-full aspect-square lg:aspect-auto lg:absolute lg:inset-0">
						<a href="/kametora_kusabana_sanpo/kusabanamemo/hibiscus-collection" class="group relative block w-full h-full overflow-hidden rounded-2xl flex items-center justify-center">
							<video
								src="/kametora_kusabana_sanpo/videos/BiscasSlideShow.mp4"
								controls={false}
								autoplay
								muted
								loop
								playsinline
								class="max-h-full max-w-full object-contain pointer-events-none group-hover:opacity-90 transition-opacity duration-300"
							></video>
                            <div class="absolute inset-0 z-10 hidden group-hover:flex items-center justify-center bg-black/30 transition-all duration-300">
                                <span class="font-serif text-white tracking-widest border border-white/50 px-4 py-2 bg-black/40 backdrop-blur-sm rounded-sm">COLLECTION</span>
                            </div>
						</a>
					</div>
				</section>
			</div>
			</div>

		<section class="mt-8 md:mt-12">
			<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
				<h2 class="flex items-center gap-3 font-serif text-2xl text-neutral-100 md:text-3xl">
					<span class="rounded-full bg-emerald-500/20 border border-emerald-400/40 px-2.5 py-1 text-[10px] font-sans font-bold uppercase tracking-[0.2em] text-emerald-300 shadow-[0_0_12px_rgba(52,211,153,0.3)]">
						E-BOOK
					</span>
					奄美の春を、草花とゆっくり歩く
				</h2>
				<a
					href="/kametora_kusabana_sanpo/pdf_view/index.html"
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-1.5 text-xs text-neutral-400 hover:text-emerald-300 transition-colors"
				>
					<span>全画面で開く</span>
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3.5 h-3.5">
						<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 21 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
					</svg>
				</a>
			</div>
			<div class="relative w-full overflow-hidden rounded-2xl border border-white/10 bg-[#18201d] shadow-[0_20px_50px_rgba(0,0,0,0.6)]">
				<iframe
					src="/kametora_kusabana_sanpo/pdf_view/index.html"
					title="奄美の春を、草花とゆっくり歩く — PDFビューア"
					class="w-full h-[620px] md:h-[720px] lg:h-[800px] border-0"
					loading="lazy"
				></iframe>
			</div>
		</section>
	</main>
</Layout>



