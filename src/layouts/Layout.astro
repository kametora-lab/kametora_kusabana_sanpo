---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	keywords?: string;
	ogType?: "website" | "article";
	ogImage?: string;
	structuredData?: unknown | Array<unknown>;
}

const { title, description = "奄美大島で出会った草花の記録。", keywords, ogType = "website", ogImage, structuredData } = Astro.props;
const base = import.meta.env.BASE_URL;
const assetBase = base.endsWith('/') ? base : `${base}/`;
const siteName = "奄美の草花さんぽ帖";
const pageTitle = `${title} | ${siteName}`;
const canonicalUrl = Astro.url;
const defaultOgImage = new URL(`${assetBase}images/ogp.png`, import.meta.env.SITE).toString();
const resolvedOgImage = ogImage ?? defaultOgImage;
const siteUrl = new URL(assetBase, import.meta.env.SITE).toString();
const siteStructuredData = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	"name": "奄美の草花さんぽ帖",
	"alternateName": "奄美の草花アルバム",
	"url": siteUrl,
	"description": "奄美大島の森や海辺、集落の道ばたで見つけた草花を写真とともに紹介する植物アルバム。南国ならではの花や樹木を、美しい写真とともに記録する奄美の草花図鑑サイトです。",
	"inLanguage": "ja",
	"creator": {
		"@type": "Person",
		"name": "かめとら",
		"url": siteUrl
	},
	"keywords": [
		"奄美",
		"草花",
		"奄美の草花",
		"奄美の花",
		"植物図鑑",
		"草花図鑑",
		"花の写真"
	],
	"genre": "自然・植物写真サイト",
	"about": [
		{ "@type": "Place", "name": "奄美大島" },
		{ "@type": "Thing", "name": "草花" },
		{ "@type": "Thing", "name": "植物" },
		{ "@type": "Thing", "name": "南国の花" },
		{ "@type": "Thing", "name": "植物図鑑" },
		{ "@type": "Thing", "name": "花の写真" }
	]
};
const extraStructuredData = structuredData
	? (Array.isArray(structuredData) ? structuredData : [structuredData])
	: [];
const allStructuredData = [siteStructuredData, ...extraStructuredData];
const structuredDataJson = JSON.stringify(allStructuredData);
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href={`${assetBase}favicon.ico?v=4`} sizes="any" />
		<link rel="icon" type="image/png" sizes="32x32" href={`${assetBase}favicon.png?v=4`} />
		<link rel="icon" type="image/png" sizes="16x16" href={`${assetBase}favicon-16.png?v=4`} />
		<link rel="apple-touch-icon" sizes="180x180" href={`${assetBase}favicon.png?v=4`} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		{keywords ? <meta name="keywords" content={keywords} /> : null}
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={resolvedOgImage} />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:locale" content="ja_JP" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={resolvedOgImage} />
		<meta name="twitter:url" content={canonicalUrl} />
		<meta name="twitter:domain" content="kametora-lab.github.io" />
		<script type="application/ld+json" set:html={structuredDataJson} />
		<title>{pageTitle}</title>
		
		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Noto+Serif+JP:wght@400;600;700&display=swap" rel="stylesheet">
	</head>
	<body class="antialiased">
		<header class="sticky top-0 z-50 bg-[#0f0f0f]/80 backdrop-blur-md border-b border-white/5">
			<div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-6 pb-6 pt-10 text-xs text-neutral-400 md:px-10 md:text-sm">
				<div class="flex items-center gap-3">
					<a href="/kametora_kusabana_sanpo" class="font-serif text-base tracking-wide text-neutral-100 md:text-lg">
						奄美の草花さんぽ帖
					</a>
					<a
						href="https://www.instagram.com/amamikusabanasanpo/"
						class="inline-flex items-center justify-center text-neutral-400 transition hover:text-neutral-200"
						aria-label="Instagram"
						target="_blank"
						rel="noreferrer noopener"
					>
						<svg viewBox="0 0 24 24" fill="none" class="h-8 w-8" aria-hidden="true">
							<rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.6" />
							<circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.6" />
							<circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" />
						</svg>
					</a>
				</div>
				<nav class="flex items-center gap-5 text-xs text-neutral-400 md:text-sm" aria-label="Site">
					<a href="/kametora_kusabana_sanpo/kusabanamemo" class="hover:text-neutral-200">奄美で出会った草花たち</a>
					<a href="/kametora_kusabana_sanpo/plants" class="hover:text-neutral-200">草花一覧</a>
					<a href="http://amamikametora.blog.fc2.com/" class="hover:text-neutral-200">本家ブログ</a>
					<a href="/kametora_kusabana_sanpo/about" class="hover:text-neutral-200">このサイトについて</a>
					<a href="/kametora_kusabana_sanpo/privacy" class="hover:text-neutral-200">プライバシーポリシー</a>
				</nav>
			</div>
		</header>
		<slot />
		<footer class="mt-16 border-t border-white/10 px-6 py-8 text-center text-xs text-neutral-500 md:px-10 md:text-sm">
			© 2022 奄美の草花さんぽ帖.
		</footer>
	</body>
</html>

